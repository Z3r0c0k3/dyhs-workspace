{
  "name": "dyhs-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:live": "tsc --noEmit && vite build --mode live",
    "start": "node apps/api/server.mjs",
    "check:config": "node apps/api/server.mjs --check-config",
    "test:server": "node --test --test-concurrency=1 tests/server/*.test.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:container": "node tests/preview-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
