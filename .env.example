# 1단계 목업은 환경 변수를 읽지 않습니다. 아래는 이후 서버 구현용 이름입니다.
# 값은 비워 두고, 검증된 운영 구성에서만 별도로 설정하세요.
# 서버 비밀을 VITE_ 접두사 변수로 만들지 마세요.

# Workspace HTTPS 공개 주소
WORKSPACE_PUBLIC_URL=
# Authentik OIDC issuer, client 및 엄격히 등록한 callback URL
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# 서버 세션 서명/암호화 키와 PostgreSQL 연결 정보
SESSION_SECRET=
DATABASE_URL=
# 검증된 메일 접근 방식과 TLS endpoint (현재 미정)
MAIL_ACCESS_MODE=
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=
# 서버 전용 Mailcow 키: 지원하는 범위에서 읽기/쓰기 및 도메인 제한 분리
MAILCOW_API_URL=
MAILCOW_READ_API_KEY=
MAILCOW_WRITE_API_KEY=
# 허용 도메인 및 서버 역할 매핑 설정 파일 경로
ROLE_MAPPING_PATH=
# 확인된 Authentik 사용자 설정 주소
AUTHENTIK_SETTINGS_URL=
# Auth CT의 공개 base URL 및 서버 전용 API 자격 (VITE_ 변수로 노출 금지)
AUTHENTIK_BASE_URL=
AUTHENTIK_API_TOKEN=
# 검증된 본인 설정 flow의 slug (미설정 시 빠른 보안 작업 비활성)
AUTHENTIK_PASSWORD_FLOW=
AUTHENTIK_PASSKEY_FLOW=
AUTHENTIK_MFA_FLOW=
# 검증된 초대 flow, 앱 생성 템플릿 및 callback host 허용 목록
AUTHENTIK_ENROLLMENT_FLOW=
AUTHENTIK_OAUTH_TEMPLATE_PATH=
OIDC_ALLOWED_REDIRECT_HOSTS=
# Mail CT SOGo CalDAV: 임의 사용자 URL 입력 금지, 인증 방식은 별도 검증
CALDAV_BASE_URL=
CALDAV_AUTH_MODE=
# URL CT 외부 서비스 진입점
DYHS_URL_PUBLIC_URL=
