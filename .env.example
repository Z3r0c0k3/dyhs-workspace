# Live 서버는 아래 현재 지원 변수를 읽습니다. 정적 미리보기는 읽지 않습니다.
# Compose 설치는 scripts/setup-live.mjs가 만드는 infra/secrets/workspace.env 사용.
# 서버 비밀을 VITE_ 접두사 변수로 만들지 마세요.

# Workspace HTTPS 공개 주소
WORKSPACE_PUBLIC_URL=
# Authentik OIDC issuer, client 및 엄격히 등록한 callback URL
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 콜백은 WORKSPACE_PUBLIC_URL + /auth/callback으로 고정됩니다.
# 직접 Node 서버 실행 시 DATABASE_URL, Compose에서는 POSTGRES_PASSWORD로 구성.
DATABASE_URL=
POSTGRES_PASSWORD=
# sub별 권한 JSON 파일 경로. roles.json 예시는 설치 문서 참조.
ROLE_MAPPING_PATH=
AUTHENTIK_BASE_URL=
AUTHENTIK_API_TOKEN=
# 생성/조회 허용 사용자 경로와 조회 허용 일반 그룹 UUID (쉼표 구분)
AUTHENTIK_USER_PATH=
AUTHENTIK_GROUP_IDS=
# 실제 배포 API/RBAC 검증 후에만 true. 기본 false.
AUTHENTIK_ENABLE_WRITES=
AUTHENTIK_PASSWORD_FLOW=
AUTHENTIK_PASSKEY_FLOW=
AUTHENTIK_MFA_FLOW=

# 명시적인 sub-메일함 매핑과 Mailcow 앱 비밀번호로만 연결. 비워 두면 비활성.
MAIL_ACCESS_MODE=
MAIL_ACCOUNTS_PATH=
MAIL_HOST=
MAIL_ID_SECRET=
MAIL_ENABLE_SEND=

# 아래는 미구현 연동의 예약 이름이며 현재 서버에서 사용하지 않습니다.
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=
# 서버 전용 Mailcow 키: 지원하는 범위에서 읽기/쓰기 및 도메인 제한 분리
MAILCOW_API_URL=
MAILCOW_READ_API_KEY=
MAILCOW_WRITE_API_KEY=
# 검증된 초대 flow, 앱 생성 템플릿 및 callback host 허용 목록
AUTHENTIK_ENROLLMENT_FLOW=
AUTHENTIK_OAUTH_TEMPLATE_PATH=
OIDC_ALLOWED_REDIRECT_HOSTS=
# Mail CT SOGo CalDAV: 임의 사용자 URL 입력 금지, 인증 방식은 별도 검증
CALDAV_BASE_URL=
CALDAV_AUTH_MODE=
# URL CT 외부 서비스 진입점
DYHS_URL_PUBLIC_URL=
